# Authentication. Replace both values before starting the service.
LIBRARIAN_BASIC_USER=librarian
LIBRARIAN_BASIC_PASS=replace-with-a-long-random-password

# Keep true behind HTTPS. Set false only when the service is restricted to a trusted
# private network and accessed directly over HTTP.
LIBRARIAN_COOKIE_SECURE=true
LIBRARIAN_PORT=8300
PUID=1000
PGID=1000

# Host directories mounted into the container. Librarian can permanently delete files
# from each writable mount.
LIBRARIAN_CONFIG_PATH=./data/config
MUSIC_PATH=./data/music
VIDEO_PATH=./data/video
BOOKS_PATH=./data/books
SLSKD_DOWNLOADS_PATH=./data/slskd-downloads

# Container-visible API endpoints and credentials. Leave an integration key empty to
# disable that manager. The books view is filesystem-only.
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=

# Change these only if the managers report paths under different container roots.
LIDARR_MUSIC_ROOT=/music
ARR_MEDIA_ROOT=/data
